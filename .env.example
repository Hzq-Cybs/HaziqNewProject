# Supabase — canonical key list for this project.
# Browser runtime reads supabase-config.js (which also accepts a
# per-browser override from the in-app Supabase setup form → localStorage).
# If you edit keys, update BOTH .env.example AND supabase-config.js.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Where password-recovery / signup emails send users back to.
# Local dev:
SUPABASE_REDIRECT_TO=http://localhost:5173/
# Prod (Vercel) — set to your deployed URL, e.g.:
# SUPABASE_REDIRECT_TO=https://haziq-new-project.vercel.app/
SITE_URL=https://haziq-new-project.vercel.app
