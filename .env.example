# Supabase — copy to .env for local tooling (never commit .env)
# Runtime for this static site reads supabase-config.js, not .env.
# Keep both in sync.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Where password-recovery / signup emails send users back to.
# Local dev:
SUPABASE_REDIRECT_TO=http://localhost:5173/
# Prod (Vercel) — set to your deployed URL, e.g.:
# SUPABASE_REDIRECT_TO=https://haziq-new-project.vercel.app/
SITE_URL=https://haziq-new-project.vercel.app
